# Backend API base URL used by the browser. Default `/api` (proxied by Vite in dev, Caddy in production).
# Set a full URL only if the API lives on another origin, e.g. https://api.example.com
VITE_API_URL=
# Where `npm run dev` proxies /api to.
BACKEND_URL=http://localhost:8000
# Google Maps JS key (browser key, HTTP-referrer restricted). Created via gcloud.
VITE_GOOGLE_MAPS_KEY=
VITE_GOOGLE_MAP_ID=
